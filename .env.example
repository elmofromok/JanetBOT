# Copy to .env for local dev. .env is gitignored; this file is not, so keep
# real values out of it.
DISCORD_TOKEN=
OPENAI_API_KEY=

# The Resident who runs Janet, as a Discord user id. The only one who can
# switch her off.
OPERATOR_ID=

# Channels Janet never listens in, as a comma-separated list of channel ids.
# Optional: leave it empty to exclude no channels. Ids rather than names, so
# renaming a channel cannot quietly re-admit her.
OPT_OUT_CHANNELS=
